{
  "expo": {
    "name": "Achievl",
    "slug": "achievl",
    "scheme": "achievl",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.achievl.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.achievl.app",
      "adaptiveIcon": {
        "backgroundColor": "#D5DADF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#D5DADF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Achievl uses the camera to scan food barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Wave",
            "ios": "./assets/icons/wave.png",
            "android": {
              "foregroundImage": "./assets/icons/wave-foreground.png",
              "backgroundColor": "#0F3B7C"
            }
          },
          {
            "name": "Aero",
            "ios": "./assets/icons/aero.png",
            "android": {
              "foregroundImage": "./assets/icons/aero-foreground.png",
              "backgroundColor": "#4FB2EC"
            }
          },
          {
            "name": "Cube",
            "ios": "./assets/icons/cube.png",
            "android": {
              "foregroundImage": "./assets/icons/cube-foreground.png",
              "backgroundColor": "#070D2B"
            }
          },
          {
            "name": "Quest",
            "ios": "./assets/icons/quest.png",
            "android": {
              "foregroundImage": "./assets/icons/quest-foreground.png",
              "backgroundColor": "#2A2389"
            }
          },
          {
            "name": "Pocket",
            "ios": "./assets/icons/pocket.png",
            "android": {
              "foregroundImage": "./assets/icons/pocket-foreground.png",
              "backgroundColor": "#9BBC0F"
            }
          },
          {
            "name": "Pixel",
            "ios": "./assets/icons/pixel.png",
            "android": {
              "foregroundImage": "./assets/icons/pixel-foreground.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Flat",
            "ios": "./assets/icons/flat.png",
            "android": {
              "foregroundImage": "./assets/icons/flat-foreground.png",
              "backgroundColor": "#15181D"
            }
          }
        ]
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.achievl.app.widgets",
          "groupIdentifier": "group.com.achievl.app",
          "widgets": []
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.achievl.app.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.achievl.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "f70d6e76-4f89-4762-adb2-22fc3c3e9f13"
      }
    },
    "owner": "mtaqub"
  }
}
